# ===============================================
# petDiary — Ambiente HOMOLOGAÇÃO (staging)
# ===============================================
#
# Como usar:
#   docker compose --env-file .env.homolog --profile hom up --build -d
#
# Diferenças do .env.local:
#   - DEBUG=False (logs JSON via structlog)
#   - gunicorn em vez de runserver
#   - bind mounts removidos (volumes nomeados Postgres)
#   - Caddy ativo (TLS automático Let's Encrypt)
#   - Mocks ainda ativos (gateway/IA/email/storage) — staging não cobra real
#
# **Substitua TUDO que está com __PLACEHOLDER__** antes do primeiro deploy.

# === Docker Compose ===
PATH_ENV_FILE=.env.homolog
COMPOSE_PROFILES=hom

# === Portas (atrás do Caddy, geralmente não expostas externamente) ===
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173
REDIS_PORT=6379

# === Volumes (deploy: sem bind mount) ===
API_VOLUMES=/dev/null:/tmp/empty
WEB_VOLUMES=/dev/null:/tmp/empty

# === API (Django) ===
# Em homolog: gunicorn 3 workers, sem reload
API_CMD=gunicorn petdiary.wsgi:application --bind 0.0.0.0:8000 --workers 3 --access-logfile - --error-logfile -

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=__GERAR_COM_secrets.token_urlsafe(64)__
DEBUG=False
ALLOWED_HOSTS=hom.petdiary.com.br,api.hom.petdiary.com.br

# Postgres gerenciado (RDS/Supabase/Railway) ou container — coloque a URL real
DATABASE_URL=postgres://petdiary:__DB_PASSWORD_HOMOLOG__@petdiary_db:5432/petdiary

# CORS — domínios do web que podem chamar a API
CORS_ALLOWED_ORIGINS=https://hom.petdiary.com.br,https://app.hom.petdiary.com.br

# === PostgreSQL (se rodando no container) ===
POSTGRES_DB=petdiary
POSTGRES_USER=petdiary
POSTGRES_PASSWORD=__DB_PASSWORD_HOMOLOG__

# === Frontend Web (Vite) — domínio público da API ===
VITE_API_URL=https://api.hom.petdiary.com.br/api/v1

# === Frontend Mobile (não roda em homolog — apenas referência) ===
EXPO_PUBLIC_API_URL=https://api.hom.petdiary.com.br/api/v1

# === Caddy ===
CADDY_PORT=80
CADDY_PORT_HTTPS=443
API_DOMAIN=api.hom.petdiary.com.br
WEB_DOMAIN=hom.petdiary.com.br

# === Celery / Redis ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# === Storage de anexos — em homolog ainda local; trocar para s3 em prod ===
ATTACHMENT_STORAGE_BACKEND=local

# === Pagamento — em homolog ainda mock (sem cobrança real) ===
BILLING_GATEWAY_MODE=mock
GATEWAY_API_KEY=
GATEWAY_WEBHOOK_SECRET=
SUBSCRIPTION_PRO_PRICE_BRL=14.90

# === IA — mock em homolog ===
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL_TEXT=gpt-4o-mini
OPENAI_MODEL_AUDIO=whisper-1

# === Email transacional ===
# "console" loga no stdout do container; "smtp" usa Django mail; "resend" stub.
# Em homolog recomenda-se SMTP de um provedor de teste (ex.: Resend modo dev,
# Mailtrap, Mailpit) para realmente enviar emails de reset de senha.
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@hom.petdiary.com.br

# Base URL do frontend — usado pra montar links de reset de senha em emails
FRONTEND_BASE_URL=https://hom.petdiary.com.br
