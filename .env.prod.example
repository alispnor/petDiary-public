# ===============================================
# petDiary — Ambiente PRODUÇÃO
# ===============================================
#
# Como usar:
#   docker compose --env-file .env.prod --profile prod up --build -d
#
# Diferenças do homolog:
#   - DOMÍNIOS reais (sem .hom)
#   - INTEGRAÇÕES REAIS (gateway, OpenAI, Resend, S3) — ATIVAR após ter credenciais
#   - PostgreSQL gerenciado (RDS/Supabase) — NÃO usar container em prod
#   - 4 workers gunicorn (ajustar conforme CPU disponível)
#
# **CRÍTICO: substitua TUDO que está com __PLACEHOLDER__ antes do primeiro deploy.**
# **NUNCA commite este arquivo com valores reais — está no .gitignore.**

# === Docker Compose ===
PATH_ENV_FILE=.env.prod
COMPOSE_PROFILES=prod

# === Portas (atrás do Caddy, NÃO expor externamente) ===
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173
REDIS_PORT=6379

# === Volumes ===
API_VOLUMES=/dev/null:/tmp/empty
WEB_VOLUMES=/dev/null:/tmp/empty

# === API (Django) ===
# 4 workers + access log estruturado. Ajuste workers a (2 * CPU + 1).
# Considere `--worker-class gevent` ou `uvicorn` se mover pra ASGI.
API_CMD=gunicorn petdiary.wsgi:application --bind 0.0.0.0:8000 --workers 4 --access-logfile - --error-logfile - --timeout 30

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=__GERAR_COM_secrets.token_urlsafe(64)__
DEBUG=False
ALLOWED_HOSTS=petdiary.com.br,app.petdiary.com.br,api.petdiary.com.br

# RECOMENDADO: Postgres gerenciado (RDS, Supabase, Neon, Railway).
# Se mantiver no container, faça backup automático em outro volume.
DATABASE_URL=postgres://__DB_USER__:__DB_PASSWORD_PROD__@__DB_HOST__:5432/__DB_NAME__

# CORS — só os domínios oficiais
CORS_ALLOWED_ORIGINS=https://app.petdiary.com.br,https://petdiary.com.br

# === PostgreSQL (apenas se DATABASE_URL aponta para container interno) ===
# Em prod com DB gerenciado, comente estas vars (o container db nem precisa subir).
POSTGRES_DB=petdiary
POSTGRES_USER=__DB_USER__
POSTGRES_PASSWORD=__DB_PASSWORD_PROD__

# === Frontend Web (Vite) ===
VITE_API_URL=https://api.petdiary.com.br/api/v1

# === Frontend Mobile (Expo Go / EAS Build) ===
EXPO_PUBLIC_API_URL=https://api.petdiary.com.br/api/v1

# === Caddy ===
CADDY_PORT=80
CADDY_PORT_HTTPS=443
API_DOMAIN=api.petdiary.com.br
WEB_DOMAIN=app.petdiary.com.br

# === Celery / Redis ===
# Em prod recomenda-se Redis gerenciado (ElastiCache, Upstash, Railway Redis).
# Se manter no container, configure persistência (AOF) e backup.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# === Storage de anexos — S3 em prod ===
# IMPORTANTE: criar bucket + IAM user com permissão mínima (PutObject,
# GetObject, DeleteObject no path do bucket). Configurar CORS no bucket
# para o domínio da web.
ATTACHMENT_STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=__AWS_ACCESS_KEY_ID__
AWS_SECRET_ACCESS_KEY=__AWS_SECRET_ACCESS_KEY__
AWS_STORAGE_BUCKET_NAME=petdiary-prod-attachments
AWS_S3_REGION_NAME=sa-east-1

# === Pagamento — Asaas ou Mercado Pago em prod ===
# Escolher um e configurar. Webhook secret valida assinatura HMAC nos
# callbacks de /webhooks/gateway/.
BILLING_GATEWAY_MODE=asaas
GATEWAY_API_KEY=__ASAAS_OU_MP_PRODUCTION_KEY__
GATEWAY_WEBHOOK_SECRET=__WEBHOOK_HMAC_SECRET__
SUBSCRIPTION_PRO_PRICE_BRL=14.90

# === IA — OpenAI em prod ===
AI_PROVIDER=openai
OPENAI_API_KEY=__OPENAI_API_KEY__
OPENAI_MODEL_TEXT=gpt-4o-mini
OPENAI_MODEL_AUDIO=whisper-1

# === Email transacional — Resend ou SMTP corporativo ===
# Resend: stub no código hoje, precisa ser implementado em accounts/services/email.py
# SMTP: rode com EMAIL_PROVIDER=smtp e configure as variáveis abaixo.
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@petdiary.com.br
RESEND_API_KEY=__RESEND_API_KEY__

# Variáveis SMTP (alternativa ao Resend):
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=__SMTP_USER__
# EMAIL_HOST_PASSWORD=__SMTP_PASSWORD__
# EMAIL_USE_TLS=True

# Base URL do frontend para links em emails (reset de senha etc)
FRONTEND_BASE_URL=https://app.petdiary.com.br

# === Observabilidade (opcional mas RECOMENDADO em prod) ===
# Sentry — capturar exceções e performance
SENTRY_DSN=__SENTRY_DSN_OR_EMPTY_TO_DISABLE__
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
